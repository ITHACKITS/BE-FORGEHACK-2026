# Standbai backend configuration. Copy to `.env`; never commit `.env`.
# The app loads `.env` on startup; variables already set in the environment win.

# 1 blocks all outbound HTTP and uses only data/ (tests, demos without internet)
STANDBAI_OFFLINE=0

# NASA FIRMS area API key (required in production)
FIRMS_MAP_KEY=
# OpenAQ key (optional, station validation)
OPENAQ_API_KEY=

# AI service (LLM gateway)
AI_SERVICE_URL=http://localhost:8001
AI_INTERNAL_TOKEN=

# Required in X-Job-Token on /jobs/*, /alerts/digest, /alerts/subscriptions
JOB_TOKEN=

# n8n instant alerts (P1)
N8N_ALERT_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Comma-separated list of allowed web origins, e.g. the Vercel domain
CORS_ORIGINS=http://localhost:5173
# Base URL for links in Telegram and chat replies
PUBLIC_APP_URL=http://localhost:5173

# Still read by the advisory until BE-04 routes it through the AI service
GEMINI_API_KEY=
